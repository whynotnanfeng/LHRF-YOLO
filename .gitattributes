# Normalize line endings on checkin; keep LF in the repository
* text=auto eol=lf

# Windows scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary / model artifacts (never committed, listed for completeness)
*.ckpt binary
*.pt binary
*.pth binary
*.onnx binary
*.engine binary
*.safetensors binary
*.jpg binary
*.jpeg binary
*.png binary
*.tif binary
*.tiff binary

# Documentation and source
*.md text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
